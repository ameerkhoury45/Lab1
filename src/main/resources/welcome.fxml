<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="WelcomeController"
      alignment="CENTER" spacing="16.0" prefWidth="420.0"
      prefHeight="360.0">
    <padding>
        <Insets top="28.0" right="32.0" bottom="28.0" left="32.0"/>
    </padding>

    <Label text="Welcome" style="-fx-font-size: 28px;"/>
    <Label fx:id="usernameLabel" text="" wrapText="true"
           maxWidth="Infinity" alignment="CENTER"
           style="-fx-font-size: 16px;"/>
    <Label text="You have successfully logged in to GCM."
           wrapText="true" maxWidth="Infinity" alignment="CENTER"/>
</VBox>
